DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# --- Database ---
# Option A: single Render-style connection string (preferred if set)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Option B: individual fields (used if DATABASE_URL is not set)
DB_ENGINE=sqlite3
DB_NAME=safeher
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

ALLOWED_HOSTS=127.0.0.1,localhost,[IP_ADDRESS]
CORS_ALLOWED_ORIGINS=http://localhost:3000,[IP_ADDRESS]
# Add your deployed domain here once live, e.g. https://safeher-backend.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- Firebase ---
# Option A (local dev): path to the downloaded service account JSON file
FIREBASE_CREDENTIALS_PATH=firebase/service_account.json
# Option B (Render / hosts without file uploads): base64 of the whole file.
# Generate with: base64 -w0 firebase/service_account.json  (Linux)
#            or: base64 -i firebase/service_account.json   (macOS)
# FIREBASE_CREDENTIALS_JSON_B64=

GEMINI_API_KEY=your-gemini-api-key-here
